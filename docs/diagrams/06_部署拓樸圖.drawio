<mxfile host="app.diagrams.net"><diagram name="圖：實驗室部署（同一台不可管理交換機）"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="560"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="net" value="校園網<br>（限速發生在閘道之後）" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="20" width="240" height="56" as="geometry"/></mxCell><mxCell id="gw" value="閘道" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="160" height="46" as="geometry"/></mxCell><mxCell id="sw" value="不可管理交換機<br>（二層網路，含另一子網的裝置）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="200" width="280" height="60" as="geometry"/></mxCell><mxCell id="pc" value="實驗室電腦（Win10）<br>AutoMAC 視窗／服務" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="230" height="70" as="geometry"/></mxCell><mxCell id="srv" value="伺服器 LAB-SERVER（Win11）<br>AutoMAC 服務、共用資料夾" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="330" width="260" height="70" as="geometry"/></mxCell><mxCell id="pi" value="監視器 Pi4 pi-monitor<br>YOLO 錄影 + nas-heal 自動重掛" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="730" y="330" width="250" height="70" as="geometry"/></mxCell><mxCell id="mdns" value="mDNS（UDP 5353）互相宣告<br>誰在用哪個 MAC" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFam