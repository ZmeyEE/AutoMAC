<mxfile host="app.diagrams.net"><diagram name="圖：組員端——背景服務（開機自動啟動）與視窗檢視器"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="540"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dbl" value="組員雙擊 automac.exe<br>（解壓縮資料夾，可事後刪除）" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="340" height="70" as="geometry"/></mxCell><mxCell id="ens" value="launcher：確保背景服務<br>沒裝就裝、版本不同就升級、沒在跑就啟動" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="340" height="80" as="geometry"/></mxCell><mxCell id="inst" value="svcinstall：複製 exe 到 ProgramData<br>登記排程工作（開機啟動、SYSTEM、當掉重啟）<br>與防火牆規則" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="340" height="90" as="geometry"/></mxCell><mxCell id="gui" value="視窗（檢視器）<br>看狀態、下指令；關掉不影響服務" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="30" width="300" height="70" as="geometry"/></mxCell><mxCell id="api" value="本機控制介面 127.0.0.1<br>（token 檔，只有管理員讀得到）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="160" width="300" height="70" as="geometry"/></mxCell><mxCell id="svc" value="背景服務 automac.exe run<br>偵測／換 MAC／同步／用量（低優先權）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="300" width="300" height="80" as="geometry"/></mxCell><mxCell id="hub" value="伺服器 HTTPS API（每 30 秒同步）<br>TLS 1.3＋釘選＋token" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="740" y="300" width="240" height="80" as="geometry"/></mxCell><mxCell id="wd" value="看門狗：讀不到網卡計數器 10 秒<br>→ 警告並重新偵測網卡" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="740" y="430" width="240" height="80" as="geometry"/></mxCell><mxCell id="tray" value="系統匣圖示 automac.exe tray<br>由 svcinstall 登記，登入時自動啟動<br>綠／黃／紅表示狀態<br>點一下開視窗、右鍵選單含解除安裝" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="735" y="30" width="255" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="dbl" target="ens"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="需要安裝／升級" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="ens" target="inst"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="開視窗" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="ens" target="gui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="啟動" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="inst" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="狀態／切換／探測" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="gui" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="api" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="svc" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="svc" target="wd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="讀狀態、跳通知" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="tray" target="api"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>