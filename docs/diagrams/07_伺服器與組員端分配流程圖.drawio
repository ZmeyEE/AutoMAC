<mxfile host="app.diagrams.net"><diagram name="圖：組員端同步清單、向伺服器要 MAC（伺服器登記處）"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="480"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="組員端（exe／視窗，可有多台）<br>清單唯讀、自動或手動切換" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="280" height="70" as="geometry"/></mxCell><mxCell id="api" value="伺服器 HTTPS API<br>TLS 1.3＋憑證釘選＋token<br>GET /pool　POST /allocate　/report　/usage" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="30" width="360" height="90" as="geometry"/></mxCell><mxCell id="srv" value="伺服器自己的切換<br>LocalPort，不經網路" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="810" y="40" width="170" height="70" as="geometry"/></mxCell><mxCell id="sync" value="每 30 秒：抓清單、回報目前 MAC 與用量<br>MAC 不在池內就自動向伺服器要一個" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="340" height="70" as="geometry"/></mxCell><mxCell id="hub" value="Hub 登記處<br>池、租約、預約、限速紀錄、用量帳本" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="190" width="380" height="70" as="geometry"/></mxCell><mxCell id="cfg" value="config.json、usage.json<br>（只能在伺服器改）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="810" y="190" width="170" height="70" as="geometry"/></mxCell><mxCell id="fb" value="連不上伺服器時：用本機快取的清單<br>＋mDNS 宣告＋鄰居掃描備援" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="340" width="340" height="70" as="geometry"/></mxCell><mxCell id="scan" value="區網鄰居掃描<br>看得到不跑 AutoMAC 的裝置" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="340" width="380" height="70" as="geometry"/></mxCell><mxCell id="e0" value="同步／回報" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="c1" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="srv" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="api" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="hub" target="cfg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="分配時重掃" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="hub" target="scan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="c1" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="連不上（逾時）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="sync" target="fb"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>