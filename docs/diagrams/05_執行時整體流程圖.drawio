<mxfile host="app.diagrams.net"><diagram name="圖：服務執行時的執行緒與資料流"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="560"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="main" value="主迴圈執行緒<br>每秒 tick" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="190" height="60" as="geometry"/></mxCell><mxCell id="samp" value="TrafficSampler<br>讀網卡計數器→Mbps" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="190" height="60" as="geometry"/></mxCell><mxCell id="det" value="Detector<br>要不要探測？" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="190" height="60" as="geometry"/></mxCell><mxCell id="work" value="工作執行緒（單一）<br>探針、切換排隊執行" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="200" width="220" height="70" as="geometry"/></mxCell><mxCell id="probe" value="run_probe<br>小探針＋有效性" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="340" width="200" height="60" as="geometry"/></mxCell><mxCell id="sw" value="Switcher<br>掃描、宣告、換 MAC、回滾" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="450" width="240" height="60" as="geometry"/></mxCell><mxCell id="bus" value="EventBus<br>事件匯流排" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="750" y="200" width="190" height="60" as="geometry"/></mxCell><mxCell id="ui" value="CLI 輸出／視窗紀錄／<br>日誌檔 automac.log" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="750" y="340" width="200" height="70" as="geometry"/></mxCell><mxCell id="pres" value="Presence<br>mDNS 宣告與發現" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="790" y="450" width="180" height="60" as="geometry"/></mxCell><mxCell id="e0" value="取樣" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="main" target="samp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="rx 樣本" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="samp" target="det"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="需要探測" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="det" target="work"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="work" target="probe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="探針結果" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="probe" target="det"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="判定限速" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="det" target="sw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="work" target="sw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="事件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="work" target="bus"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="事件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="sw" target="bus"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="訂閱" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="bus" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="佔用與宣告" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="sw" target="pres"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>