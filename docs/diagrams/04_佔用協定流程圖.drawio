<mxfile host="app.diagrams.net"><diagram name="圖：MAC 佔用協定（借用 RFC 5227 的探測與宣告概念）"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="560"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a" value="想使用某 MAC" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="20" width="160" height="46" as="geometry"/></mxCell><mxCell id="b" value="宣告 state=claiming<br>附毫秒時間戳" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="200" height="56" as="geometry"/></mxCell><mxCell id="c" value="等待 1.5 秒＋隨機抖動<br>讓同伴回應" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="190" width="200" height="56" as="geometry"/></mxCell><mxCell id="d" value="看同一 MAC 的其他宣告" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="280" width="200" height="50" as="geometry"/></mxCell><mxCell id="e" value="有人已 holding？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="360" width="180" height="70" as="geometry"/></mxCell><mxCell id="f" value="有人 claiming 且<br>（時間戳, 名稱）更小？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="455" width="240" height="80" as="geometry"/></mxCell><mxCell id="lose" value="放棄：還原原宣告<br>換下一個候選" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="380" width="200" height="56" as="geometry"/></mxCell><mxCell id="win" value="取得使用權<br>接著換 MAC，換完宣告 holding" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="470" width="240" height="60" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="d" target="e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="e" target="lose"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="e" target="f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="f" target="lose"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="否" style="ed