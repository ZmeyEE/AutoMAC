<mxfile host="app.diagrams.net"><diagram name="圖：AutoMAC 架構分層（上層只依賴下層）"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="790"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="band_ui" value="呈現層：只做顯示與接收操作，不含判斷" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff6ea;strokeColor=#d79b00;fontFamily=DFKai-SB;fontSize=13;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="920" height="90" as="geometry"/></mxCell><mxCell id="band_sys" value="協調層：把下層串起來、排程、發出事件；伺服器登記處與用量帳本" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f6effa;strokeColor=#9673a6;fontFamily=DFKai-SB;fontSize=13;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="920" height="150" as="geometry"/></mxCell><mxCell id="band_logic" value="純邏輯層：不碰系統與網路，時間由外部傳入，可用真實樣本重播" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f0f8ee;strokeColor=#82b366;fontFamily=DFKai-SB;fontSize=13;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="382" width="920" height="90" as="geometry"/></mxCell><mxCell id="band_edge" value="系統與網路邊界：碰作業系統與網路，都有小介面，測試時換成假物件" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="518" width="920" height="90" as="geometry"/></mxCell><mxCell id="band_base" value="基礎層：格式、統計、設定檔、PowerShell 唯一入口" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;fontFamily=DFKai-SB;fontSize=13;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="654" width="920" height="90" as="geometry"/></mxCell><mxCell id="cli" value="cli<br>命令列" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="90" width="200" height="48" as="geometry"/></mxCell><mxCell id="gui" value="gui/<br>視窗（tkinter）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="200" height="48" as="geometry"/></mxCell><mxCell id="service" value="service<br>背景主迴圈、入網配發" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="226" width="200" height="48" as="geometry"/></mxCell><mxCell id="switcher" value="switcher<br>切換流程與回滾" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="226" width="200" height="48" as="geometry"/></mxCell><mxCell id="events" value="events / hooks<br>事件、外掛命令" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="226" width="200" height="48" as="geometry"/></mxCell><mxCell id="hub" value="hub<br>登記處、組員端、API" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="280" width="200" height="48" as="geometry"/></mxCell><mxCell id="ledger" value="ledger<br>用量帳本" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="280" width="200" height="48" as="geometry"/></mxCell><mxCell id="takeover" value="takeover<br>接手背景服務" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="280" width="200" height="48" as="geometry"/></mxCell><mxCell id="detector" value="detector<br>限速判斷狀態機" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="422" width="200" height="48" as="geometry"/></mxCell><mxCell id="policy" value="policy<br>選 MAC、頻率限制" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="422" width="200" height="48" as="geometry"/></mxCell><mxCell id="replay" value="replay<br>樣本重播" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="422" width="200" height="48" as="geometry"/></mxCell><mxCell id="probe" value="probe<br>小探針" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="52" y="558" width="140" height="48" as="geometry"/></mxCell><mxCell id="traffic" value="traffic<br>網卡流量" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="202" y="558" width="140" height="48" as="geometry"/></mxCell><mxCell id="scanner" value="scanner<br>鄰居掃描" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="352" y="558" width="140" height="48" as="geometry"/></mxCell><mxCell id="presence" value="presence<br>mDNS 宣告" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="502" y="558" width="140" height="48" as="geometry"/></mxCell><mxCell id="nic" value="nic<br>網卡與換 MAC" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="652" y="558" width="140" height="48" as="geometry"/></mxCell><mxCell id="tlsutil" value="tlsutil<br>TLS 1.3、憑證釘選" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="802" y="558" width="140" height="48" as="geometry"/></mxCell><mxCell id="config" value="config<br>設定檔與狀態檔" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="694" width="200" height="48" as="geometry"/></mxCell><mxCell id="macaddr" value="macaddr / stats<br>MAC 格式與統計" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="694" width="200" height="48" as="geometry"/></mxCell><mxCell id="winshell" value="winshell<br>PowerShell 入口" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="694" width="200" height="48" as="geometry"/></mxCell><mxCell id="e0" value="呼叫" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="band_ui" target="band_sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="使用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="band_sys" target="band_logic"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="取得資料／下指令" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="band_logic" target="band_edge"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="依賴" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="band_edge" target="band_base"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>