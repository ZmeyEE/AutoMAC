<mxfile host="app.diagrams.net"><diagram name="圖：限速偵測流程（每秒一次）"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s" value="每秒取樣<br>網卡下載 rx" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="30" width="160" height="50" as="geometry"/></mxCell><mxCell id="q" value="安靜？<br>10 秒中位數＜3 Mbps<br>且最近 3 秒平均＜3 Mbps" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="240" height="90" as="geometry"/></mxCell><mxCell id="busy" value="流量大<br>不探測、不打擾" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="when" value="該探測了？<br>（確認、換後驗證、<br>平線指紋、閒置間隔）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="240" width="240" height="90" as="geometry"/></mxCell><mxCell id="wait" value="等下一秒" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="260" width="150" height="50" as="geometry"/></mxCell><mxCell id="probe" value="發 256 KB 探針<br>記錄探針前後網卡位元組" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="370" width="200" height="56" as="geometry"/></mxCell><mxCell id="ok" value="探針完成？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="465" width="160" height="70" as="geometry"/></mxCell><mxCell id="down" value="net_down：不計次<br>退避 15 秒" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="475" width="180" height="50" as="geometry"/></mxCell><mxCell id="valid" value="有效？<br>（期間其他流量＜3 Mbps）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="575" width="200" height="80" as="geometry"/></mxCell><mxCell id="inv" value="無效：不計次<br>退避 10 秒" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="585" width="180" height="50" as="geometry"/></mxCell><mxCell id="slow" value="低於 2 Mbps？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="695" width="160" height="70" as="geometry"/></mxCell><mxCell id="healthy" value="healthy：<br>偏慢次數歸零" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="705" width="180" height="50" as="geometry"/></mxCell><mxCell id="strike" value="偏慢次數 +1<br>≥ 2 次？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="805" width="160" height="70" as="geometry"/></mxCell><mxCell id="again" value="5 秒後再確認<br>（60 秒內有效）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="150" y="815" width="180" height="50" as="geometry"/></mxCell><mxCell id="thr" value="判定限速<br>→ 交給切換流程" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=DFKai-SB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="815" width="180" height="50" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="s" target="q"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="q" target="busy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="q" target="when"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="when" target="wait"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="when" target="probe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="probe" target="ok"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="ok" target="down"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="ok" target="valid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="valid" target="inv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="valid" target="slow"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="slow" target="healthy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="slow" target="strike"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="strike" target="again"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;fontFamily=DFKai-SB;fontSize=12;" edge="1" parent="1" source="strike" target="thr"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>